{
  "groups": {
    "delegate_word": {
      "label": "delegate language",
      "patterns": ["\\bdelegat(?:e|ed|es|ing|ion|ions)\\b"]
    },
    "maintainer": {
      "label": "maintainer",
      "patterns": ["\\bmaintainer\\b"]
    },
    "help_escalation": {
      "label": "ask for help",
      "patterns": ["\\b(?:ask|request|contact|call|escalat)\\w*\\b.{0,60}\\b(?:help|maintainer)\\b"]
    }
  }
}
